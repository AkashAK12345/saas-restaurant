// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

// GLOBAL identity lifecycle — distinct from MembershipStatus.
//
// UserStatus governs whether the account may authenticate at all, anywhere on
// the platform. MembershipStatus governs whether a user participates in ONE
// company. Removing an employee from a company is a membership change; an
// INACTIVE UserStatus means the person can no longer sign in to SAMCO at all.
// The two are deliberately not collapsed.
enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum TableStatus {
  ACTIVE
  INACTIVE
}

// Physical display/kiosk screens. Distinct from users: a device authenticates
// with its own credential and is never granted RBAC permissions.
enum DisplayDeviceKind {
  QUEUE_CUSTOMER
  QUEUE_ADMIN
  BANQUET_CHEF
}

enum DisplayDeviceStatus {
  ACTIVE
  REVOKED
}

// Queue token lifecycle (Phase 7). Transitions are constrained by the state
// machine in apps/api/src/modules/queue-tokens/queue-state-machine.ts — the
// database stores the status, the application decides which changes are legal.
//
//   SCHEDULED ─▶ WAITING ─▶ CALLED ─▶ SEATED
//       │           ▲          ├────▶ NO_SHOW
//       │           └── skip ──┤
//       └───────────┴──────────┴────▶ CANCELLED
//
// SCHEDULED is an advance booking that has not surfaced yet; it is appended
// last so the migration can add it without rewriting the type.
enum QueueTokenStatus {
  WAITING
  CALLED
  SEATED
  NO_SHOW
  CANCELLED
  SCHEDULED
}

// ── Banquet (Phase 8) ────────────────────────────────────────────────────────

enum BanquetHallStatus {
  ACTIVE
  INACTIVE
}

enum BanquetPackageStatus {
  ACTIVE
  INACTIVE
}

// Booking lifecycle. Transitions are constrained by the state machine in
// apps/api/src/modules/banquet/banquet-state-machine.ts.
//
//   DRAFT ─▶ CONFIRMED ─▶ COMPLETED
//     └──────────┴──────▶ CANCELLED
//
// CONFLICT PARTICIPATION: only CONFIRMED and COMPLETED occupy a hall. A DRAFT
// is a tentative enquiry that deliberately does NOT block anyone — several may
// exist for the same slot — and confirming is what claims the hall. A
// CANCELLED booking releases it.
enum BanquetBookingStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

// Preparation state of one snapshotted booking item on the chef display.
enum BanquetKdsStatus {
  PENDING
  IN_PROGRESS
  READY
}

// A priced line added to a booking after the package snapshot. Each kind is
// separately permissioned (see permission-keys.ts): extra charges and line or
// per-head discounts are routine; an admin discount is a lump-sum override.
enum BanquetAdjustmentKind {
  EXTRA_CHARGE
  LINE_DISCOUNT
  PER_HEAD_DISCOUNT
  ADMIN_DISCOUNT
}

// Which stage of settlement a payment represents. Decided by the server at
// insert time (first payment = ADVANCE, the one that settles = FINAL, anything
// between = INTERIM) and never rewritten. NULL on rows recorded before this
// column existed — history is not guessed at.
enum BanquetPaymentKind {
  ADVANCE
  INTERIM
  FINAL
}

// One row per lifecycle step; see QueueTokenEvent.
enum QueueTokenEventType {
  REGISTERED
  CALLED
  SEATED
  NO_SHOW
  CANCELLED
  TABLE_ASSIGNED
  TABLE_RELEASED
  // A called party did not respond and went back to the waiting list.
  SKIPPED
  // A scheduled party arrived and was checked in by staff.
  CHECKED_IN
  // A scheduled party surfaced automatically at its booked time.
  ACTIVATED
}

// ── Tasks & Routines (Phase 9) ───────────────────────────────────────────────

// Task lifecycle. Transitions are constrained by the state machine in
// apps/api/src/modules/tasks/task-state-machine.ts.
//
//   PENDING ─▶ IN_PROGRESS ─▶ COMPLETED
//      │            └────────▶ CANCELLED
//      ├─────────────────────▶ COMPLETED   (a small job needs no "start")
//      └─────────────────────▶ CANCELLED
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

// Where a task came from. The seam that lets future modules generate tasks
// without Phase 9 knowing anything about them.
enum TaskSource {
  MANUAL
  ROUTINE
}

// Recurrence a routine supports. Deliberately two: DAILY covers "every day at
// 06:00", WEEKLY covers "every Monday at 09:00", and between them they cover
// the operational routines a restaurant actually runs. MONTHLY is not
// implemented — month-end semantics (the 31st in February) are a product
// decision nobody has made.
enum RoutineFrequency {
  DAILY
  WEEKLY
}

enum RoutineStatus {
  ACTIVE
  INACTIVE
}

enum ChecklistTemplateStatus {
  ACTIVE
  INACTIVE
}

enum AuditEventType {
  CREATE
  UPDATE
  DELETE
  SECURITY // e.g. login, permission change
}

// -----------------------------------------------------------------------------
// GLOBAL ENTITIES
// -----------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  password_hash String
  first_name    String?
  last_name     String?
  is_superadmin Boolean    @default(false)
  // Global sign-in capability. See UserStatus.
  status        UserStatus @default(ACTIVE)
  created_at    DateTime   @default(now()) @db.Timestamptz(3)
  updated_at    DateTime   @updatedAt @db.Timestamptz(3)

  // Relationships
  sessions     UserSession[]
  memberships  CompanyMembership[]
  branch_roles UserBranchRole[]
  audit_logs   AuditLog[]
  queue_token_events QueueTokenEvent[]
  banquet_payments   BanquetPayment[]
  banquet_adjustments           BanquetBookingAdjustment[]
  banquet_payment_verifications BanquetPaymentVerification[]
  assigned_tasks     Task[]              @relation("TaskAssignee")
  completed_tasks    Task[]              @relation("TaskCompleter")
  created_tasks      Task[]              @relation("TaskCreator")
  tasks_assigned_by  Task[]              @relation("TaskAssigner")
  task_comments      TaskComment[]
  checklist_items_done TaskChecklistItem[] @relation("ChecklistItemDoneBy")
  default_for_routines TaskRoutine[]     @relation("RoutineDefaultAssignee")
  plates_requested     BanquetPlateRequest[] @relation("PlateRequestedBy")
  plates_decided       BanquetPlateRequest[] @relation("PlateDecidedBy")
  plates_dispatched    BanquetPlateRequest[] @relation("PlateDispatchedBy")

  // Declares the index created by migration 20260906130000_user_status so the
  // schema matches the database; without this Prisma tries to DROP it.
  @@index([status])
  @@map("users")
}

// -----------------------------------------------------------------------------
// TENANT ENTITIES
// -----------------------------------------------------------------------------

model Company {
  id         String        @id @default(uuid()) @db.Uuid
  name       String
  status     CompanyStatus @default(ACTIVE)
  created_at DateTime      @default(now()) @db.Timestamptz(3)
  updated_at DateTime      @updatedAt @db.Timestamptz(3)

  // Relationships
  branches    Branch[]
  memberships CompanyMembership[]
  roles       Role[]
  audit_logs  AuditLog[]
  customers   Customer[]
  queue_tokens QueueToken[]
  banquet_packages BanquetPackage[]
  inventory_categories InventoryCategory[]
  inventory_items      InventoryItem[]
  stock_movements      StockMovement[]
  vendors          Vendor[]
  purchase_orders  PurchaseOrder[]
  pos_orders       PosOrder[]
  banquet_bookings BanquetBooking[]
  banquet_plate_requests BanquetPlateRequest[]
  checklist_templates ChecklistTemplate[]
  task_routines       TaskRoutine[]
  tasks               Task[]

  @@map("companies")
}

model CompanyMembership {
  id         String           @id @default(uuid()) @db.Uuid
  user_id    String           @db.Uuid
  company_id String           @db.Uuid
  status     MembershipStatus @default(ACTIVE)
  created_at DateTime         @default(now()) @db.Timestamptz(3)
  updated_at DateTime         @updatedAt @db.Timestamptz(3)

  // Relationships
  user    User    @relation(fields: [user_id], references: [id], onDelete: Restrict)
  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)

  @@unique([user_id, company_id])
  @@index([user_id])
  @@index([company_id])
  @@map("company_memberships")
}

model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  company_id String       @db.Uuid
  name       String
  timezone   String // e.g., 'Asia/Kolkata', 'America/New_York'
  status     BranchStatus @default(ACTIVE)
  // Statutory identifiers printed on a banquet bill (India). Optional: a branch
  // that is not GST-registered leaves them empty.
  gstin                String?
  fssai_license        String?
  // GST applied to NEW banquet bookings, in basis points (500 = 5%, split
  // equally into CGST and SGST). 0 is no-GST mode. Snapshotted per booking.
  banquet_gst_rate_bps Int          @default(0)
  // Terms and conditions printed at the foot of every banquet bill and
  // quotation from this branch. Free text, at most 4000 characters (CHECK).
  banquet_terms        String?
  created_at DateTime     @default(now()) @db.Timestamptz(3)
  updated_at DateTime     @updatedAt @db.Timestamptz(3)

  // Relationships
  company         Company          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  user_roles      UserBranchRole[]
  audit_logs      AuditLog[]
  tables          Table[]
  display_devices DisplayDevice[]
  queue_tokens    QueueToken[]
  queue_counters  QueueCounter[]
  stock_movements  StockMovement[]
  purchase_orders  PurchaseOrder[]
  pos_orders       PosOrder[]
  banquet_halls    BanquetHall[]
  banquet_bookings BanquetBooking[]
  banquet_plate_requests BanquetPlateRequest[]
  task_routines    TaskRoutine[]
  tasks            Task[]

  @@index([company_id])
  @@map("branches")
}

// -----------------------------------------------------------------------------
// OPERATIONAL FOUNDATIONS (introduced for Phases 7–10)
// -----------------------------------------------------------------------------

// Company-scoped so one customer record is reusable across every branch of a
// company. Deliberately minimal: Roadmap Phase 2 (Master Data) extends this
// model; it must not be replaced.
model Customer {
  id         String         @id @default(uuid()) @db.Uuid
  company_id String         @db.Uuid
  name       String
  // Stored NORMALIZED (see CustomersService). Optional because Queue
  // Management must accept anonymous walk-ins.
  phone      String?
  status     CustomerStatus @default(ACTIVE)
  created_at DateTime       @default(now()) @db.Timestamptz(3)
  updated_at DateTime       @updatedAt @db.Timestamptz(3)

  company      Company      @relation(fields: [company_id], references: [id], onDelete: Restrict)
  queue_tokens QueueToken[]
  banquet_bookings BanquetBooking[]

  // PostgreSQL unique indexes treat NULLs as distinct, so this enforces
  // "one customer per normalized phone per company" while allowing any number
  // of phoneless customers — no partial index or raw SQL needed.
  @@unique([company_id, phone])
  @@index([company_id])
  @@map("customers")
}

// Branch-scoped seating unit. Roadmap Phase 2 may later insert a Floor between
// Branch and Table by adding a nullable floor_id — the direct branch_id stays
// as the authorization scope, so that change is purely additive.
model Table {
  id         String      @id @default(uuid()) @db.Uuid
  branch_id  String      @db.Uuid
  label      String
  capacity   Int
  // Free-text grouping hint only (e.g. "Terrace"). Not a Floor entity.
  zone       String?
  status     TableStatus @default(ACTIVE)
  created_at DateTime    @default(now()) @db.Timestamptz(3)
  updated_at DateTime    @updatedAt @db.Timestamptz(3)

  branch       Branch       @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  queue_tokens QueueToken[]

  @@unique([branch_id, label])
  @@index([branch_id])
  @@map("tables")
}

// A physical screen (queue board, chef board, ...). Authenticates with a
// long-lived opaque credential whose SHA-256 hash is stored here — the raw
// value is shown exactly once at pairing time. Never holds RBAC permissions.
model DisplayDevice {
  id              String              @id @default(uuid()) @db.Uuid
  branch_id       String              @db.Uuid
  name            String
  kind            DisplayDeviceKind
  credential_hash String
  status          DisplayDeviceStatus @default(ACTIVE)
  revoked_at      DateTime?           @db.Timestamptz(3)
  created_at      DateTime            @default(now()) @db.Timestamptz(3)
  updated_at      DateTime            @updatedAt @db.Timestamptz(3)

  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Restrict)

  @@index([branch_id])
  @@index([status])
  @@map("display_devices")
}

// -----------------------------------------------------------------------------
// QUEUE MANAGEMENT (Phase 7)
// -----------------------------------------------------------------------------

// A party waiting for a table. Branch-scoped; company_id is denormalised so a
// token can be scoped in a single WHERE without a join (the same pattern the
// authorization checks use everywhere else).
//
// Status changes only happen through the explicit domain operations in
// QueueTokensService (call / seat / no-show / cancel / assign-table /
// release-table); there is no generic update path.
//
// Table occupancy: a token holds a table while it is SEATED with a non-null
// assigned_table_id. Releasing the table (a manual queue operation until POS
// exists) clears assigned_table_id; the assignment itself is preserved in the
// TABLE_ASSIGNED / TABLE_RELEASED events. Exclusivity is enforced by the
// partial unique index queue_tokens_one_seated_party_per_table (raw SQL in the
// migration — Prisma cannot express partial indexes).
model QueueToken {
  id                String           @id @default(uuid()) @db.Uuid
  company_id        String           @db.Uuid
  branch_id         String           @db.Uuid
  // Optional: anonymous walk-ins have no customer record.
  customer_id       String?          @db.Uuid
  // Calendar date in the BRANCH timezone. Token numbers restart at 1 per
  // branch per service date.
  service_date      DateTime         @db.Date
  token_number      Int
  status            QueueTokenStatus @default(WAITING)
  /// Guests, split for capacity planning: a table for 2 adults + 2 kids is not
  /// the same seating problem as one for 4 adults.
  adults            Int
  kids              Int              @default(0)
  /// The TOTAL, kept as a stored column rather than derived on read: every
  /// board, report and display already reads it, and a database CHECK holds it
  /// equal to adults + kids so the two can never disagree.
  party_size        Int
  /// Set when the guest asked for a table at a later time rather than joining
  /// the live queue. Recorded and displayed; it deliberately does NOT reorder
  /// calling, which is a capacity-planning decision nobody has specified yet.
  advance_booking_at DateTime?       @db.Timestamptz(3)
  assigned_table_id String?          @db.Uuid
  called_at         DateTime?        @db.Timestamptz(3)
  seated_at         DateTime?        @db.Timestamptz(3)
  cancelled_at      DateTime?        @db.Timestamptz(3)
  no_show_at        DateTime?        @db.Timestamptz(3)
  /// The last time a called party was skipped back to the waiting list. A
  /// skipped party waits behind everyone not yet called, in skip order.
  skipped_at        DateTime?        @db.Timestamptz(3)
  skip_count        Int              @default(0)
  created_at        DateTime         @default(now()) @db.Timestamptz(3)
  updated_at        DateTime         @updatedAt @db.Timestamptz(3)

  company        Company           @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch         Branch            @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  customer       Customer?         @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  assigned_table Table?            @relation(fields: [assigned_table_id], references: [id], onDelete: Restrict)
  events         QueueTokenEvent[]

  @@unique([branch_id, service_date, token_number])
  @@index([branch_id, service_date, status])
  // The activation job's scan: scheduled parties whose booked time has come.
  @@index([status, advance_booking_at])
  @@index([company_id])
  @@index([customer_id])
  @@index([assigned_table_id])
  @@map("queue_tokens")
}

// Append-only lifecycle history of a token. UPDATE and DELETE are rejected by
// database triggers (see the migration), mirroring audit_logs.
model QueueTokenEvent {
  id              String              @id @default(uuid()) @db.Uuid
  queue_token_id  String              @db.Uuid
  event_type      QueueTokenEventType
  previous_status QueueTokenStatus?
  new_status      QueueTokenStatus
  // Null when the step is not performed by a staff user (reserved for the
  // scheduler / device paths that later phases add).
  actor_user_id   String?             @db.Uuid
  // Only for table events: { table_id }. Nothing else is stored here.
  metadata        Json?
  created_at      DateTime            @default(now()) @db.Timestamptz(3)

  queue_token QueueToken @relation(fields: [queue_token_id], references: [id], onDelete: Restrict)
  actor       User?      @relation(fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@index([queue_token_id, created_at])
  @@map("queue_token_events")
}

// Per-branch, per-service-date token allocator. Allocation is a single
// INSERT ... ON CONFLICT DO UPDATE ... RETURNING statement inside the
// registration transaction, so PostgreSQL's row lock serialises concurrent
// registrations and no two transactions can observe the same number.
// next_number is the next value to hand out.
model QueueCounter {
  id           String   @id @default(uuid()) @db.Uuid
  branch_id    String   @db.Uuid
  service_date DateTime @db.Date
  next_number  Int      @default(1)
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  updated_at   DateTime @updatedAt @db.Timestamptz(3)

  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Restrict)

  @@unique([branch_id, service_date])
  @@map("queue_counters")
}

// -----------------------------------------------------------------------------
// BANQUET MANAGEMENT (Phase 8)
// -----------------------------------------------------------------------------

// A function room. Branch-scoped, exactly like Table. Deliberately NOT related
// to the deferred Phase 2 Floor model.
model BanquetHall {
  id         String            @id @default(uuid()) @db.Uuid
  branch_id  String            @db.Uuid
  name       String
  capacity   Int
  status     BanquetHallStatus @default(ACTIVE)
  created_at DateTime          @default(now()) @db.Timestamptz(3)
  updated_at DateTime          @updatedAt @db.Timestamptz(3)

  branch   Branch            @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  bookings BanquetBooking[]
  slots    BanquetHallSlot[]

  @@unique([branch_id, name])
  @@index([branch_id])
  @@map("banquet_halls")
}

// A named service window a hall is sold in ("Lunch 11:00–16:00"). Branch-local
// wall-clock times: the availability view turns them into real instants per
// date with the branch timezone. An end at or before the start runs past
// midnight. A slot is a template for picking a window, not a booking — the
// exclusion constraint on banquet_bookings stays the one guard against
// double-booking.
model BanquetHallSlot {
  id         String            @id @default(uuid()) @db.Uuid
  hall_id    String            @db.Uuid
  name       String
  start_time String
  end_time   String
  position   Int               @default(0)
  status     BanquetHallStatus @default(ACTIVE)
  created_at DateTime          @default(now()) @db.Timestamptz(3)
  updated_at DateTime          @updatedAt @db.Timestamptz(3)

  hall BanquetHall @relation(fields: [hall_id], references: [id], onDelete: Restrict)

  @@unique([hall_id, name])
  @@index([hall_id])
  @@map("banquet_hall_slots")
}

// A commercial offering. COMPANY-scoped like Customer, so one catalogue serves
// every branch. This is not a Product/Menu system: it exists only to price a
// banquet and to hand the kitchen a list of components.
//
// MONEY: price_per_guest_minor is an INTEGER in the minor unit of `currency`
// (e.g. paise for INR, cents for USD). No floating point is used anywhere in
// the money path. The price is PER GUEST — the banquet convention — so a
// booking's total is price × guest_count. That choice is documented in
// banquet-money.ts and snapshotted onto every booking.
model BanquetPackage {
  id                    String               @id @default(uuid()) @db.Uuid
  company_id            String               @db.Uuid
  name                  String
  description           String?
  price_per_guest_minor Int
  currency              String               @db.Char(3)
  status                BanquetPackageStatus @default(ACTIVE)
  created_at            DateTime             @default(now()) @db.Timestamptz(3)
  updated_at            DateTime             @updatedAt @db.Timestamptz(3)

  company  Company              @relation(fields: [company_id], references: [id], onDelete: Restrict)
  items    BanquetPackageItem[]
  bookings BanquetBooking[]

  @@unique([company_id, name])
  @@index([company_id])
  @@map("banquet_packages")
}

// A component of a package (a dish, a service line). Snapshotted onto a booking
// at creation time; editing the package later never rewrites history.
model BanquetPackageItem {
  id         String   @id @default(uuid()) @db.Uuid
  package_id String   @db.Uuid
  name       String
  position   Int
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  package BanquetPackage @relation(fields: [package_id], references: [id], onDelete: Restrict)

  @@index([package_id])
  @@map("banquet_package_items")
}

// A booked event. Branch-scoped; company_id is denormalised for single-query
// scoping, the same pattern QueueToken uses.
//
// TIME: starts_at / ends_at are absolute instants (timestamptz). Overlap is
// therefore evaluated on the real timeline and is DST-proof by construction —
// no wall-clock arithmetic is involved. The branch timezone is used only to
// PRESENT an event and to group the chef display by branch-local day.
//
// SNAPSHOTS: package_name, price_per_guest_minor, currency and
// total_amount_minor are copied at creation. A later edit to the package
// cannot change what a historical booking meant or cost.
//
// The hall is protected by a PostgreSQL exclusion constraint; see the
// migration. `balance` is deliberately NOT a column — it is derived as
// total_amount_minor minus successful payments.
model BanquetBooking {
  id                    String               @id @default(uuid()) @db.Uuid
  company_id            String               @db.Uuid
  branch_id             String               @db.Uuid
  customer_id           String               @db.Uuid
  hall_id               String               @db.Uuid
  package_id            String?              @db.Uuid
  starts_at             DateTime             @db.Timestamptz(3)
  ends_at               DateTime             @db.Timestamptz(3)
  guest_count           Int
  status                BanquetBookingStatus @default(DRAFT)
  // Commercial snapshot, fixed at booking time.
  package_name          String
  price_per_guest_minor Int
  currency              String               @db.Char(3)
  // Recomputed by the service (banquet-money.ts priceBooking) inside the same
  // locked transaction as any change to its inputs: price, guests, extra pax,
  // GST rate and the append-only adjustments.
  total_amount_minor    Int
  // Hall name as it stood when the booking was made or moved. Nullable only
  // for rows written outside the service; the service always sets it.
  hall_name             String?
  // Guests over the guaranteed count (guest_count), charged at the same rate.
  extra_pax             Int                  @default(0)
  // GST snapshot in basis points; 0 = no GST. See Branch.banquet_gst_rate_bps.
  gst_rate_bps          Int                  @default(0)
  // Sum of recorded payments, maintained in the payment transaction under the
  // booking row lock. The CHECK paid_minor <= total_amount_minor makes an
  // overpayment impossible even outside the service.
  paid_minor            Int                  @default(0)
  notes                 String?
  cancellation_reason   String?
  confirmed_at          DateTime?            @db.Timestamptz(3)
  completed_at          DateTime?            @db.Timestamptz(3)
  cancelled_at          DateTime?            @db.Timestamptz(3)
  created_at            DateTime             @default(now()) @db.Timestamptz(3)
  updated_at            DateTime             @updatedAt @db.Timestamptz(3)

  company     Company                    @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch      Branch                     @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  customer    Customer                   @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  hall        BanquetHall                @relation(fields: [hall_id], references: [id], onDelete: Restrict)
  package     BanquetPackage?            @relation(fields: [package_id], references: [id], onDelete: Restrict)
  items       BanquetBookingItem[]
  payments    BanquetPayment[]
  adjustments BanquetBookingAdjustment[]
  event_plan  BanquetEventPlan?
  plate_requests BanquetPlateRequest[]
  photos      BanquetBookingPhoto[]

  @@index([branch_id, starts_at])
  @@index([branch_id, status])
  @@index([company_id])
  @@index([customer_id])
  @@index([hall_id])
  @@map("banquet_bookings")
}

// The package components as they stood when the booking was made, plus the
// kitchen's preparation state for each. The chef display reads these; staff
// with banquet.kds.manage advance them.
model BanquetBookingItem {
  id          String           @id @default(uuid()) @db.Uuid
  booking_id  String           @db.Uuid
  name        String
  position    Int
  kds_status  BanquetKdsStatus @default(PENDING)
  started_at  DateTime?        @db.Timestamptz(3)
  ready_at    DateTime?        @db.Timestamptz(3)
  created_at  DateTime         @default(now()) @db.Timestamptz(3)
  updated_at  DateTime         @updatedAt @db.Timestamptz(3)

  booking        BanquetBooking        @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  plate_requests BanquetPlateRequest[]

  @@index([booking_id])
  @@map("banquet_booking_items")
}

enum BanquetPlateRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  DISPATCHED
}

// Plate approval (SRS §5.3.5): service staff ask the kitchen for N plates of
// one dish of a confirmed event; someone OTHER than the requester approves or
// rejects; approved plates are dispatched. Portion control for buffets.
//
// Lifecycle in banquet-state-machine.ts. The migration adds CHECKs so the
// stamps always agree with the status, a rejection always carries its reason,
// and nobody can decide their own request — whatever writes the row.
model BanquetPlateRequest {
  id                    String                    @id @default(uuid()) @db.Uuid
  company_id            String                    @db.Uuid
  branch_id             String                    @db.Uuid
  booking_id            String                    @db.Uuid
  item_id               String                    @db.Uuid
  plates                Int
  note                  String?
  status                BanquetPlateRequestStatus @default(REQUESTED)
  requested_by_user_id  String                    @db.Uuid
  decided_by_user_id    String?                   @db.Uuid
  decided_at            DateTime?                 @db.Timestamptz(3)
  rejection_reason      String?
  dispatched_by_user_id String?                   @db.Uuid
  dispatched_at         DateTime?                 @db.Timestamptz(3)
  created_at            DateTime                  @default(now()) @db.Timestamptz(3)
  updated_at            DateTime                  @updatedAt @db.Timestamptz(3)

  company       Company            @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch        Branch             @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  booking       BanquetBooking     @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  item          BanquetBookingItem @relation(fields: [item_id], references: [id], onDelete: Restrict)
  requested_by  User               @relation("PlateRequestedBy", fields: [requested_by_user_id], references: [id], onDelete: Restrict)
  decided_by    User?              @relation("PlateDecidedBy", fields: [decided_by_user_id], references: [id], onDelete: Restrict)
  dispatched_by User?              @relation("PlateDispatchedBy", fields: [dispatched_by_user_id], references: [id], onDelete: Restrict)

  @@index([booking_id])
  @@index([item_id])
  @@index([branch_id, status])
  @@map("banquet_plate_requests")
}

// The operational plan for one booking: when food is served, how the room is
// set, and what the kitchen needs to know. Deliberately three fields and no
// task list — a task/checklist system is Phase 9 and must not be pre-empted.
model BanquetEventPlan {
  id            String    @id @default(uuid()) @db.Uuid
  booking_id    String    @unique @db.Uuid
  service_at    DateTime? @db.Timestamptz(3)
  setup_notes   String?
  kitchen_notes String?
  created_at    DateTime  @default(now()) @db.Timestamptz(3)
  updated_at    DateTime  @updatedAt @db.Timestamptz(3)

  booking BanquetBooking @relation(fields: [booking_id], references: [id], onDelete: Restrict)

  @@map("banquet_event_plans")
}

// An advance or balance payment against a booking. APPEND-ONLY: UPDATE and
// DELETE are rejected by database triggers, exactly as for audit_logs and
// queue_token_events. There is no refund path — the roadmap does not define
// one, and inventing a negative payment would silently become accounting.
//
// This is NOT Finance: there is no ledger, no journal and no accounting entry.
// It records what a customer paid against one event.
model BanquetPayment {
  id            String   @id @default(uuid()) @db.Uuid
  booking_id    String   @db.Uuid
  company_id    String   @db.Uuid
  branch_id     String   @db.Uuid
  amount_minor  Int
  currency      String   @db.Char(3)
  paid_at       DateTime @db.Timestamptz(3)
  // Free-text snapshot only ("cash", "card ****1234"). PaymentMethod is a
  // deferred Phase 2 entity and is deliberately not referenced.
  method        String?
  reference     String?
  kind          BanquetPaymentKind?
  actor_user_id String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(3)
  // Corrects a mistaken payment without ever UPDATEing the row the database
  // trigger protects: this row reverses that one (unique, so a payment can be
  // corrected only once) and the service records a fresh, right payment next
  // to it in the same transaction. Both cancel out of paid_minor.
  reverses_id   String?  @unique @db.Uuid

  booking      BanquetBooking              @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  actor        User?                       @relation(fields: [actor_user_id], references: [id], onDelete: Restrict)
  verification BanquetPaymentVerification?
  reverses     BanquetPayment?             @relation("PaymentCorrection", fields: [reverses_id], references: [id], onDelete: Restrict)
  correction   BanquetPayment?             @relation("PaymentCorrection")

  @@index([booking_id, paid_at])
  // Phase 10: the banquet payments report scans one branch over a date
  // window. Without this it is a sequential scan of every payment ever
  // taken, filtered afterwards.
  @@index([branch_id, paid_at])
  @@map("banquet_payments")
}

// A priced change to a booking after its package snapshot: an extra charge or
// one of three discount kinds. APPEND-ONLY (database triggers). Removing a
// line is a new row that names the one it reverses (`reverses_id`, unique, so
// a line is reversed at most once) — the history of what was offered and
// withdrawn stays readable.
//
// amount_minor is always positive; the kind decides the sign. A
// PER_HEAD_DISCOUNT is per plate and multiplies by the booking's current head
// count when priced.
model BanquetBookingAdjustment {
  id            String                @id @default(uuid()) @db.Uuid
  booking_id    String                @db.Uuid
  company_id    String                @db.Uuid
  branch_id     String                @db.Uuid
  kind          BanquetAdjustmentKind
  description   String
  amount_minor  Int
  reverses_id   String?               @unique @db.Uuid
  actor_user_id String?               @db.Uuid
  created_at    DateTime              @default(now()) @db.Timestamptz(3)

  booking  BanquetBooking            @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  actor    User?                     @relation(fields: [actor_user_id], references: [id], onDelete: Restrict)
  reverses BanquetBookingAdjustment? @relation("AdjustmentReversal", fields: [reverses_id], references: [id], onDelete: Restrict)
  reversal BanquetBookingAdjustment? @relation("AdjustmentReversal")

  @@index([booking_id, created_at])
  @@map("banquet_booking_adjustments")
}

// Second-person confirmation that a recorded payment was actually received.
// One per payment, APPEND-ONLY, and never by the person who recorded it (the
// service refuses; the reference system's "payment verification").
model BanquetPaymentVerification {
  id                  String   @id @default(uuid()) @db.Uuid
  payment_id          String   @unique @db.Uuid
  company_id          String   @db.Uuid
  branch_id           String   @db.Uuid
  verified_by_user_id String   @db.Uuid
  note                String?
  verified_at         DateTime @default(now()) @db.Timestamptz(3)

  payment     BanquetPayment @relation(fields: [payment_id], references: [id], onDelete: Restrict)
  verified_by User           @relation(fields: [verified_by_user_id], references: [id], onDelete: Restrict)

  @@map("banquet_payment_verifications")
}

model BanquetBookingPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  booking_id String   @db.Uuid
  data       Bytes
  mime_type  String   @db.VarChar(64)
  file_name  String?  @db.VarChar(255)
  position   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(3)

  booking BanquetBooking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([booking_id])
  @@map("banquet_booking_photos")
}

// -----------------------------------------------------------------------------
// TASKS & ROUTINES (Phase 9)
// -----------------------------------------------------------------------------

// A reusable checklist definition. COMPANY-scoped like Customer and
// BanquetPackage, so one definition serves every branch.
//
// Editing a template NEVER rewrites history: a task copies the items it needs
// at creation time (see TaskChecklistItem), so a completed task cannot become
// retroactively incomplete because someone added an item to the template.
model ChecklistTemplate {
  id          String                  @id @default(uuid()) @db.Uuid
  company_id  String                  @db.Uuid
  name        String
  description String?
  status      ChecklistTemplateStatus @default(ACTIVE)
  created_at  DateTime                @default(now()) @db.Timestamptz(3)
  updated_at  DateTime                @updatedAt @db.Timestamptz(3)

  company  Company                 @relation(fields: [company_id], references: [id], onDelete: Restrict)
  items    ChecklistTemplateItem[]
  routines TaskRoutine[]
  tasks    Task[]

  @@unique([company_id, name])
  @@index([company_id])
  @@map("checklist_templates")
}

// What an item asks for. CHECK is a tick; the others need an answer, and the
// answer is what marks the item done. YES_NO is an explicit "YES" or "NO"
// answer — unlike CHECK, "No" is recorded rather than indistinguishable from
// unanswered. PHOTO is done once it has at least one attached photo (see
// TaskChecklistItemPhoto) — its state is managed through the item-photo
// endpoints, never through the scalar-answer PATCH.
enum ChecklistItemKind {
  CHECK
  NUMBER
  TEXT
  RATING
  DATE
  TIME
  PHOTO
  YES_NO
}

model ChecklistTemplateItem {
  id          String            @id @default(uuid()) @db.Uuid
  template_id String            @db.Uuid
  label       String
  position    Int
  kind        ChecklistItemKind @default(CHECK)
  is_required Boolean           @default(true)
  /// Optional group label ("Today's Summary", "EB", ...). Items sharing a
  /// section are rendered together; null items render flat, exactly as every
  /// checklist does today. Purely a display grouping — no ordering of its own,
  /// items are still ordered by `position` and a section's items must be
  /// contiguous in that order.
  section     String?  @db.VarChar(80)
  /// PHOTO items only: how many photos the item takes. Null = the default
  /// (MAX_ITEM_PHOTOS in tasks.dto.ts). Always null for other kinds.
  max_photos  Int?
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  template ChecklistTemplate @relation(fields: [template_id], references: [id], onDelete: Restrict)

  @@index([template_id])
  @@map("checklist_template_items")
}

// A recurring operational definition. BRANCH-scoped, which is what makes the
// timezone unambiguous: a routine's wall-clock time is always read in its
// branch's own timezone (Branch.timezone), never in UTC and never in the
// server's zone. A company-level routine is deliberately not offered — it
// would have no single timezone to be scheduled in.
model TaskRoutine {
  id          String           @id @default(uuid()) @db.Uuid
  company_id  String           @db.Uuid
  branch_id   String           @db.Uuid
  name        String
  description String?
  frequency   RoutineFrequency
  /// Branch-local wall clock, "HH:MM". Interpreted in Branch.timezone.
  time_of_day String
  /// Optional submission deadline, branch-local "HH:MM" on the occurrence day,
  /// never earlier than time_of_day. When set, a generated task is due then
  /// rather than at the moment it appears. Null keeps the original behaviour
  /// (due at time_of_day).
  due_time    String?
  /// WEEKLY only: 0 = Sunday … 6 = Saturday, in branch-local time.
  weekdays    Int[]
  priority    TaskPriority     @default(NORMAL)
  status      RoutineStatus    @default(ACTIVE)
  /// Copied onto each generated task at materialization time.
  checklist_template_id String? @db.Uuid
  default_assignee_id   String? @db.Uuid
  created_at  DateTime         @default(now()) @db.Timestamptz(3)
  updated_at  DateTime         @updatedAt @db.Timestamptz(3)

  company           Company            @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch            Branch             @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  checklist         ChecklistTemplate? @relation(fields: [checklist_template_id], references: [id], onDelete: Restrict)
  default_assignee  User?              @relation("RoutineDefaultAssignee", fields: [default_assignee_id], references: [id], onDelete: Restrict)
  tasks             Task[]

  @@unique([branch_id, name])
  @@index([branch_id, status])
  @@index([company_id])
  @@map("task_routines")
}

// A concrete operational task. Branch-scoped; company_id is denormalised for
// single-query scoping, the pattern QueueToken and BanquetBooking both use.
//
// IDEMPOTENT ROUTINE MATERIALIZATION: (routine_id, routine_occurrence_date) is
// UNIQUE. PostgreSQL treats NULLs as distinct, so manual tasks — which have
// neither — never collide, while a routine can produce at most one task per
// branch-local occurrence date no matter how many materialization runs race.
// That is the whole idempotency guarantee, enforced by the database rather
// than by an application check that could lose a race.
//
// ASSIGNMENT IS NOT AUTHORIZATION. assignee_id records who is responsible for
// doing the work. It grants nothing: every API operation is still gated by
// RBAC through PermissionGuard.
model Task {
  id                     String       @id @default(uuid()) @db.Uuid
  company_id             String       @db.Uuid
  branch_id              String       @db.Uuid
  title                  String
  description            String?
  status                 TaskStatus   @default(PENDING)
  priority               TaskPriority @default(NORMAL)
  due_at                 DateTime?    @db.Timestamptz(3)
  assignee_id            String?      @db.Uuid
  source                 TaskSource   @default(MANUAL)
  routine_id             String?      @db.Uuid
  /// Branch-local calendar date of the occurrence this task materialises.
  routine_occurrence_date DateTime?   @db.Date
  /// Template the checklist was copied from, for reference only.
  checklist_template_id  String?      @db.Uuid
  started_at             DateTime?    @db.Timestamptz(3)
  completed_at           DateTime?    @db.Timestamptz(3)
  completed_by           String?      @db.Uuid
  cancelled_at           DateTime?    @db.Timestamptz(3)
  /// Who raised the task by hand. Null for routine-generated tasks (the
  /// scheduler is not a person) and for tasks created before this was tracked.
  created_by             String?      @db.Uuid
  /// Who made the CURRENT assignment, and when. Assignment is responsibility,
  /// never authorization — see the note above.
  assigned_by            String?      @db.Uuid
  assigned_at            DateTime?    @db.Timestamptz(3)
  /// How many times responsibility moved from one person to another. Clearing
  /// an assignment is not a reassignment; handing it to someone else is.
  reassignment_count     Int          @default(0)
  created_at             DateTime     @default(now()) @db.Timestamptz(3)
  updated_at             DateTime     @updatedAt @db.Timestamptz(3)

  company        Company            @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch         Branch             @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  assignee       User?              @relation("TaskAssignee", fields: [assignee_id], references: [id], onDelete: Restrict)
  completer      User?              @relation("TaskCompleter", fields: [completed_by], references: [id], onDelete: Restrict)
  creator        User?              @relation("TaskCreator", fields: [created_by], references: [id], onDelete: Restrict)
  assigner       User?              @relation("TaskAssigner", fields: [assigned_by], references: [id], onDelete: Restrict)
  routine        TaskRoutine?       @relation(fields: [routine_id], references: [id], onDelete: Restrict)
  checklist_from ChecklistTemplate? @relation(fields: [checklist_template_id], references: [id], onDelete: Restrict)
  checklist      TaskChecklistItem[]
  comments       TaskComment[]

  @@unique([routine_id, routine_occurrence_date])
  @@index([branch_id, status])
  @@index([branch_id, due_at])
  @@index([assignee_id, status])
  // "Own tasks" visibility reads tasks a user raised as well as those assigned.
  @@index([created_by])
  @@index([company_id])
  // Phase 10: every task report groups one branch's tasks by the period
  // they were raised in. The existing branch indexes are on status and
  // due_at, neither of which helps that range scan.
  @@index([branch_id, created_at])
  @@map("tasks")
}

// A task's OWN checklist: a snapshot taken when the task was created, never a
// live view of the template. Completion state lives here, so history stays
// truthful however the template changes afterwards.
model TaskChecklistItem {
  id          String            @id @default(uuid()) @db.Uuid
  task_id     String            @db.Uuid
  label       String
  position    Int
  kind        ChecklistItemKind @default(CHECK)
  is_required Boolean           @default(true)
  is_done     Boolean           @default(false)
  /// The answer for a non-CHECK, non-PHOTO item, in canonical text form
  /// ("12.5", "2026-09-15", "4"). Null while unanswered, always null for
  /// CHECK and PHOTO (a PHOTO item's "answer" is its attached photos).
  value       String?
  /// Copied from ChecklistTemplateItem.section at snapshot time — see there.
  section     String?  @db.VarChar(80)
  /// Copied from ChecklistTemplateItem.max_photos at snapshot time.
  max_photos  Int?
  done_at     DateTime? @db.Timestamptz(3)
  done_by     String?   @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(3)
  updated_at  DateTime  @updatedAt @db.Timestamptz(3)

  task   Task                     @relation(fields: [task_id], references: [id], onDelete: Restrict)
  doneBy User?                    @relation("ChecklistItemDoneBy", fields: [done_by], references: [id], onDelete: Restrict)
  photos TaskChecklistItemPhoto[]

  @@index([task_id])
  @@map("task_checklist_items")
}

// A photo attached to a PHOTO-kind checklist item. Mirrors BanquetBookingPhoto
// exactly (bytes in Postgres — SAMCO has no object storage): capped at the
// item's max_photos (MAX_ITEM_PHOTOS when unset) and MAX_PHOTO_SIZE_BYTES
// each, enforced in TasksService, not here.
model TaskChecklistItemPhoto {
  id                String   @id @default(uuid()) @db.Uuid
  checklist_item_id String   @db.Uuid
  data              Bytes
  mime_type         String   @db.VarChar(64)
  file_name         String?  @db.VarChar(255)
  position          Int      @default(0)
  created_at        DateTime @default(now()) @db.Timestamptz(3)

  item TaskChecklistItem @relation(fields: [checklist_item_id], references: [id], onDelete: Cascade)

  @@index([checklist_item_id])
  @@map("task_checklist_item_photos")
}

// A note left on a task by a member of staff. APPEND-ONLY: there is no edit
// or delete path, and database triggers reject UPDATE and DELETE, exactly as
// for audit_logs — a conversation about work is part of its history.
model TaskComment {
  id         String   @id @default(uuid()) @db.Uuid
  task_id    String   @db.Uuid
  author_id  String   @db.Uuid
  body       String
  created_at DateTime @default(now()) @db.Timestamptz(3)

  task   Task @relation(fields: [task_id], references: [id], onDelete: Restrict)
  author User @relation(fields: [author_id], references: [id], onDelete: Restrict)

  @@index([task_id, created_at])
  @@map("task_comments")
}

// -----------------------------------------------------------------------------
// AUTHORIZATION ENTITIES (RBAC)
// -----------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  company_id  String   @db.Uuid
  name        String
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  // Relationships
  company     Company          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  user_roles  UserBranchRole[]

  @@unique([company_id, name])
  @@index([company_id])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique // e.g., 'pos.order.create'
  module      String // e.g., 'pos', 'inventory'
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  // Relationships
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  // Relationships
  role       Role       @relation(fields: [role_id], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Restrict)

  @@id([role_id, permission_id])
  @@index([role_id])
  @@index([permission_id])
  @@map("role_permissions")
}

model UserBranchRole {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  branch_id  String   @db.Uuid
  role_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  // Relationships
  user   User   @relation(fields: [user_id], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [role_id], references: [id], onDelete: Restrict)

  // Constraints
  // A user can only hold a specific role once at a specific branch
  @@unique([user_id, branch_id, role_id])
  @@index([user_id])
  @@index([branch_id])
  @@index([role_id])
  @@map("user_branch_roles")
}

// -----------------------------------------------------------------------------
// AUDIT ENTITIES
// -----------------------------------------------------------------------------

model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  company_id  String?        @db.Uuid
  branch_id   String?        @db.Uuid
  user_id     String?        @db.Uuid
  event_type  AuditEventType
  entity_type String // e.g., 'Order', 'User'
  entity_id   String
  payload     Json // JSONB via PostgreSQL
  created_at  DateTime       @default(now()) @db.Timestamptz(3)

  // Relationships
  company Company? @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch  Branch?  @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  user    User?    @relation(fields: [user_id], references: [id], onDelete: Restrict)

  // Indexes optimized for time-series and scoping queries
  @@index([company_id, created_at])
  @@index([branch_id, created_at])
  @@index([event_type, created_at])
  @@index([entity_type, entity_id])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// AUTHENTICATION & SESSIONS
// -----------------------------------------------------------------------------

model UserSession {
  id                  String    @id @default(uuid()) @db.Uuid
  user_id             String    @db.Uuid
  token_hash          String
  // Sliding window — pushed forward on every successful refresh.
  expires_at          DateTime  @db.Timestamptz(3)
  // Hard ceiling — fixed at login, never extended by refresh.
  absolute_expires_at DateTime  @db.Timestamptz(3)
  revoked_at          DateTime? @db.Timestamptz(3)
  // What the owner needs to recognise a login on the "signed-in devices"
  // screen. Captured at login, never used for authorization.
  user_agent          String?
  ip_address          String?
  last_used_at        DateTime? @db.Timestamptz(3)
  created_at          DateTime  @default(now()) @db.Timestamptz(3)
  updated_at          DateTime  @updatedAt @db.Timestamptz(3)

  // Relationships
  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id])
  @@index([expires_at])
  @@index([revoked_at])
  @@index([absolute_expires_at])
  @@map("user_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Point of sale — orders, what was on them, and how they were paid.
//
// Reporting comes first: POS Reports reads these tables. Nothing takes orders
// yet — the order-taking screen is its own module — so until then they stay
// empty and the reports say so. Money is integer minor units, as everywhere.
// ─────────────────────────────────────────────────────────────────────────────

enum PosOrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PosOrderStatus {
  OPEN
  PAID
  CANCELLED
}

enum PosPaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  OTHER
}

model PosOrder {
  id           String         @id @default(uuid()) @db.Uuid
  company_id   String         @db.Uuid
  branch_id    String         @db.Uuid
  /// The number printed on the bill, unique within its branch.
  order_number String         @db.VarChar(40)
  order_type   PosOrderType
  status       PosOrderStatus @default(OPEN)
  /// Table name as it stood when the order was taken (dine-in only).
  table_label  String?        @db.VarChar(60)
  /// What the order came to, after discounts and tax.
  total_minor  Int            @default(0)
  currency     String         @db.Char(3)
  opened_at    DateTime       @default(now()) @db.Timestamptz(3)
  paid_at      DateTime?      @db.Timestamptz(3)
  cancelled_at DateTime?      @db.Timestamptz(3)
  created_at   DateTime       @default(now()) @db.Timestamptz(3)
  updated_at   DateTime       @updatedAt @db.Timestamptz(3)

  company  Company        @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch   Branch         @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  items    PosOrderItem[]
  payments PosPayment[]

  @@unique([branch_id, order_number])
  // Every POS report scans one branch over a window of order times.
  @@index([branch_id, opened_at])
  @@map("pos_orders")
}

model PosOrderItem {
  id               String @id @default(uuid()) @db.Uuid
  order_id         String @db.Uuid
  /// Menu item name as it stood when ordered.
  name             String @db.VarChar(160)
  quantity         Int
  unit_price_minor Int
  line_total_minor Int
  position         Int    @default(0)

  order PosOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("pos_order_items")
}

model PosPayment {
  id           String           @id @default(uuid()) @db.Uuid
  order_id     String           @db.Uuid
  method       PosPaymentMethod
  amount_minor Int
  paid_at      DateTime         @db.Timestamptz(3)

  order PosOrder @relation(fields: [order_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@map("pos_payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Purchasing — vendors, the purchase orders a branch sends them, and what was
// on each order.
//
// Reporting comes first, as with point of sale: Purchase Reports reads these
// tables, and raising purchase orders is the module still to come. A purchase
// order is usually sent to its vendor on WhatsApp; `whatsapp_sent_at` records
// that it was, not how. Money is integer minor units.
// ─────────────────────────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  ORDERED
  RECEIVED
  CANCELLED
}

model Vendor {
  id         String   @id @default(uuid()) @db.Uuid
  company_id String   @db.Uuid
  /// The business's own name — unique in the company.
  name       String   @db.VarChar(160)
  /// What staff call them, when not the business name: "Seafood", "Oil".
  label      String?  @db.VarChar(80)
  /// The number purchase orders are sent to.
  phone      String?  @db.VarChar(32)
  email      String?  @db.VarChar(160)
  /// PURCHASE (we buy from them), SALE (we sell to them) or BOTH.
  type       String   @default("PURCHASE") @db.VarChar(16)
  is_active  Boolean  @default(true)
  gst_registered Boolean @default(false)
  gstin      String?  @db.VarChar(20)
  /// Tax collected at source, in basis points.
  tcs_rate_bps Int    @default(0)
  fssai_no   String?  @db.VarChar(20)
  pan        String?  @db.VarChar(12)
  address    String?
  city       String?  @db.VarChar(80)
  state      String?  @db.VarChar(80)
  pincode    String?  @db.VarChar(10)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  company         Company         @relation(fields: [company_id], references: [id], onDelete: Restrict)
  purchase_orders PurchaseOrder[]

  @@unique([company_id, name])
  @@map("vendors")
}

model PurchaseOrder {
  id               String              @id @default(uuid()) @db.Uuid
  company_id       String              @db.Uuid
  branch_id        String              @db.Uuid
  vendor_id        String              @db.Uuid
  /// The number on the order, unique within its branch.
  po_number        String              @db.VarChar(40)
  status           PurchaseOrderStatus @default(ORDERED)
  /// How the order was raised. Only "MANUAL" today — typed in by staff;
  /// orders raised from a stock request or a reorder level will say so.
  source           String              @default("MANUAL") @db.VarChar(24)
  total_minor      Int                 @default(0)
  /// What has been paid to the vendor against this order so far. What is
  /// left (total - paid) is the order's share of "Outstanding".
  paid_minor       Int                 @default(0)
  currency         String              @db.Char(3)
  ordered_at       DateTime            @default(now()) @db.Timestamptz(3)
  whatsapp_sent_at DateTime?           @db.Timestamptz(3)
  received_at      DateTime?           @db.Timestamptz(3)
  cancelled_at     DateTime?           @db.Timestamptz(3)
  notes            String?
  created_at       DateTime            @default(now()) @db.Timestamptz(3)
  updated_at       DateTime            @updatedAt @db.Timestamptz(3)

  company Company             @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch  Branch              @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  vendor  Vendor              @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  items   PurchaseOrderItem[]

  @@unique([branch_id, po_number])
  // Purchase reports scan one branch over a window of order times.
  @@index([branch_id, ordered_at])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String  @id @default(uuid()) @db.Uuid
  purchase_order_id String  @db.Uuid
  /// Item name as ordered, e.g. "Basmati rice".
  name              String  @db.VarChar(160)
  /// Up to three decimals: 12.5 kg is a real order.
  quantity          Decimal @db.Decimal(12, 3)
  /// "kg", "L", "pcs"…; free text, as vendors quote it.
  unit              String? @db.VarChar(16)
  unit_price_minor  Int
  line_total_minor  Int
  position          Int     @default(0)

  order PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)

  @@index([purchase_order_id])
  @@map("purchase_order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventory — the company's products, and every movement of stock at a branch.
//
// Stock is never stored as a number to overwrite: it is the SUM of a branch's
// movements for an item (opening balance, purchases received, consumption,
// transfers in and out, adjustments). Quantities are signed: in is positive,
// out is negative. Consumed and Purchase for a period are the movements of
// that kind inside it.
// ─────────────────────────────────────────────────────────────────────────────

model InventoryCategory {
  id         String   @id @default(uuid()) @db.Uuid
  company_id String   @db.Uuid
  name       String   @db.VarChar(80)
  created_at DateTime @default(now()) @db.Timestamptz(3)

  company Company         @relation(fields: [company_id], references: [id], onDelete: Restrict)
  items   InventoryItem[]

  @@unique([company_id, name])
  @@map("inventory_categories")
}

model InventoryItem {
  id          String   @id @default(uuid()) @db.Uuid
  company_id  String   @db.Uuid
  name        String   @db.VarChar(160)
  /// The unit stock is counted and consumed in: "case", "Kg", "BOX".
  unit        String   @db.VarChar(24)
  category_id String?  @db.Uuid
  sub_category String? @db.VarChar(80)
  /// The unit it is bought in, when not the stock unit ("Bag"), and how many
  /// stock units one of it holds (a 50 Kg bag: 50). Null: bought as counted.
  purchase_unit  String?  @db.VarChar(24)
  conversion_qty Decimal? @db.Decimal(12, 3)
  /// Prices per purchase unit, in minor units, before tax.
  purchase_price_minor Int?
  transfer_price_minor Int?
  /// GST in basis points: 18% is 1800.
  tax_rate_bps Int?
  hsn          String? @db.VarChar(16)
  /// The short code or barcode the kitchen knows it by.
  short_code   String? @db.VarChar(40)
  /// A kitchen department (Indian, Chinese, …), or none for general stock.
  department  String?  @db.VarChar(40)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  company   Company            @relation(fields: [company_id], references: [id], onDelete: Restrict)
  category  InventoryCategory? @relation(fields: [category_id], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([company_id, name, unit])
  @@index([company_id, name])
  @@map("inventory_items")
}

enum StockMovementKind {
  OPENING
  PURCHASE
  CONSUMPTION
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  company_id    String            @db.Uuid
  branch_id     String            @db.Uuid
  item_id       String            @db.Uuid
  kind          StockMovementKind
  /// Signed: into the branch is positive, out of it negative.
  quantity      Decimal           @db.Decimal(14, 3)
  occurred_at   DateTime          @default(now()) @db.Timestamptz(3)
  note          String?
  actor_user_id String?           @db.Uuid
  created_at    DateTime          @default(now()) @db.Timestamptz(3)

  company Company       @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch  Branch        @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  item    InventoryItem @relation(fields: [item_id], references: [id], onDelete: Restrict)

  // The grid sums one item at one branch; the period columns scan by time.
  @@index([branch_id, item_id])
  @@index([company_id, occurred_at])
  @@map("stock_movements")
}
