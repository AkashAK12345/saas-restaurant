// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

// GLOBAL identity lifecycle — distinct from MembershipStatus.
//
// UserStatus governs whether the account may authenticate at all, anywhere on
// the platform. MembershipStatus governs whether a user participates in ONE
// company. Removing an employee from a company is a membership change; an
// INACTIVE UserStatus means the person can no longer sign in to SAMCO at all.
// The two are deliberately not collapsed.
enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum TableStatus {
  ACTIVE
  INACTIVE
}

// Physical display/kiosk screens. Distinct from users: a device authenticates
// with its own credential and is never granted RBAC permissions.
enum DisplayDeviceKind {
  QUEUE_CUSTOMER
  QUEUE_ADMIN
  BANQUET_CHEF
}

enum DisplayDeviceStatus {
  ACTIVE
  REVOKED
}

// Queue token lifecycle (Phase 7). Transitions are constrained by the state
// machine in apps/api/src/modules/queue-tokens/queue-state-machine.ts — the
// database stores the status, the application decides which changes are legal.
//
//   WAITING ─▶ CALLED ─▶ SEATED
//      │          ├────▶ NO_SHOW
//      └──────────┴────▶ CANCELLED
enum QueueTokenStatus {
  WAITING
  CALLED
  SEATED
  NO_SHOW
  CANCELLED
}

// ── Banquet (Phase 8) ────────────────────────────────────────────────────────

enum BanquetHallStatus {
  ACTIVE
  INACTIVE
}

enum BanquetPackageStatus {
  ACTIVE
  INACTIVE
}

// Booking lifecycle. Transitions are constrained by the state machine in
// apps/api/src/modules/banquet/banquet-state-machine.ts.
//
//   DRAFT ─▶ CONFIRMED ─▶ COMPLETED
//     └──────────┴──────▶ CANCELLED
//
// CONFLICT PARTICIPATION: only CONFIRMED and COMPLETED occupy a hall. A DRAFT
// is a tentative enquiry that deliberately does NOT block anyone — several may
// exist for the same slot — and confirming is what claims the hall. A
// CANCELLED booking releases it.
enum BanquetBookingStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

// Preparation state of one snapshotted booking item on the chef display.
enum BanquetKdsStatus {
  PENDING
  IN_PROGRESS
  READY
}

// One row per lifecycle step; see QueueTokenEvent.
enum QueueTokenEventType {
  REGISTERED
  CALLED
  SEATED
  NO_SHOW
  CANCELLED
  TABLE_ASSIGNED
  TABLE_RELEASED
}

// ── Tasks & Routines (Phase 9) ───────────────────────────────────────────────

// Task lifecycle. Transitions are constrained by the state machine in
// apps/api/src/modules/tasks/task-state-machine.ts.
//
//   PENDING ─▶ IN_PROGRESS ─▶ COMPLETED
//      │            └────────▶ CANCELLED
//      ├─────────────────────▶ COMPLETED   (a small job needs no "start")
//      └─────────────────────▶ CANCELLED
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

// Where a task came from. The seam that lets future modules generate tasks
// without Phase 9 knowing anything about them.
enum TaskSource {
  MANUAL
  ROUTINE
}

// Recurrence a routine supports. Deliberately two: DAILY covers "every day at
// 06:00", WEEKLY covers "every Monday at 09:00", and between them they cover
// the operational routines a restaurant actually runs. MONTHLY is not
// implemented — month-end semantics (the 31st in February) are a product
// decision nobody has made.
enum RoutineFrequency {
  DAILY
  WEEKLY
}

enum RoutineStatus {
  ACTIVE
  INACTIVE
}

enum ChecklistTemplateStatus {
  ACTIVE
  INACTIVE
}

enum AuditEventType {
  CREATE
  UPDATE
  DELETE
  SECURITY // e.g. login, permission change
}

// -----------------------------------------------------------------------------
// GLOBAL ENTITIES
// -----------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  password_hash String
  first_name    String?
  last_name     String?
  is_superadmin Boolean    @default(false)
  // Global sign-in capability. See UserStatus.
  status        UserStatus @default(ACTIVE)
  created_at    DateTime   @default(now()) @db.Timestamptz(3)
  updated_at    DateTime   @updatedAt @db.Timestamptz(3)

  // Relationships
  sessions     UserSession[]
  memberships  CompanyMembership[]
  branch_roles UserBranchRole[]
  audit_logs   AuditLog[]
  queue_token_events QueueTokenEvent[]
  banquet_payments   BanquetPayment[]
  assigned_tasks     Task[]              @relation("TaskAssignee")
  completed_tasks    Task[]              @relation("TaskCompleter")
  checklist_items_done TaskChecklistItem[] @relation("ChecklistItemDoneBy")
  default_for_routines TaskRoutine[]     @relation("RoutineDefaultAssignee")

  // Declares the index created by migration 20260906130000_user_status so the
  // schema matches the database; without this Prisma tries to DROP it.
  @@index([status])
  @@map("users")
}

// -----------------------------------------------------------------------------
// TENANT ENTITIES
// -----------------------------------------------------------------------------

model Company {
  id         String        @id @default(uuid()) @db.Uuid
  name       String
  status     CompanyStatus @default(ACTIVE)
  created_at DateTime      @default(now()) @db.Timestamptz(3)
  updated_at DateTime      @updatedAt @db.Timestamptz(3)

  // Relationships
  branches    Branch[]
  memberships CompanyMembership[]
  roles       Role[]
  audit_logs  AuditLog[]
  customers   Customer[]
  queue_tokens QueueToken[]
  banquet_packages BanquetPackage[]
  banquet_bookings BanquetBooking[]
  checklist_templates ChecklistTemplate[]
  task_routines       TaskRoutine[]
  tasks               Task[]

  @@map("companies")
}

model CompanyMembership {
  id         String           @id @default(uuid()) @db.Uuid
  user_id    String           @db.Uuid
  company_id String           @db.Uuid
  status     MembershipStatus @default(ACTIVE)
  created_at DateTime         @default(now()) @db.Timestamptz(3)
  updated_at DateTime         @updatedAt @db.Timestamptz(3)

  // Relationships
  user    User    @relation(fields: [user_id], references: [id], onDelete: Restrict)
  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)

  @@unique([user_id, company_id])
  @@index([user_id])
  @@index([company_id])
  @@map("company_memberships")
}

model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  company_id String       @db.Uuid
  name       String
  timezone   String // e.g., 'Asia/Kolkata', 'America/New_York'
  status     BranchStatus @default(ACTIVE)
  created_at DateTime     @default(now()) @db.Timestamptz(3)
  updated_at DateTime     @updatedAt @db.Timestamptz(3)

  // Relationships
  company         Company          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  user_roles      UserBranchRole[]
  audit_logs      AuditLog[]
  tables          Table[]
  display_devices DisplayDevice[]
  queue_tokens    QueueToken[]
  queue_counters  QueueCounter[]
  banquet_halls    BanquetHall[]
  banquet_bookings BanquetBooking[]
  task_routines    TaskRoutine[]
  tasks            Task[]

  @@index([company_id])
  @@map("branches")
}

// -----------------------------------------------------------------------------
// OPERATIONAL FOUNDATIONS (introduced for Phases 7–10)
// -----------------------------------------------------------------------------

// Company-scoped so one customer record is reusable across every branch of a
// company. Deliberately minimal: Roadmap Phase 2 (Master Data) extends this
// model; it must not be replaced.
model Customer {
  id         String         @id @default(uuid()) @db.Uuid
  company_id String         @db.Uuid
  name       String
  // Stored NORMALIZED (see CustomersService). Optional because Queue
  // Management must accept anonymous walk-ins.
  phone      String?
  status     CustomerStatus @default(ACTIVE)
  created_at DateTime       @default(now()) @db.Timestamptz(3)
  updated_at DateTime       @updatedAt @db.Timestamptz(3)

  company      Company      @relation(fields: [company_id], references: [id], onDelete: Restrict)
  queue_tokens QueueToken[]
  banquet_bookings BanquetBooking[]

  // PostgreSQL unique indexes treat NULLs as distinct, so this enforces
  // "one customer per normalized phone per company" while allowing any number
  // of phoneless customers — no partial index or raw SQL needed.
  @@unique([company_id, phone])
  @@index([company_id])
  @@map("customers")
}

// Branch-scoped seating unit. Roadmap Phase 2 may later insert a Floor between
// Branch and Table by adding a nullable floor_id — the direct branch_id stays
// as the authorization scope, so that change is purely additive.
model Table {
  id         String      @id @default(uuid()) @db.Uuid
  branch_id  String      @db.Uuid
  label      String
  capacity   Int
  // Free-text grouping hint only (e.g. "Terrace"). Not a Floor entity.
  zone       String?
  status     TableStatus @default(ACTIVE)
  created_at DateTime    @default(now()) @db.Timestamptz(3)
  updated_at DateTime    @updatedAt @db.Timestamptz(3)

  branch       Branch       @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  queue_tokens QueueToken[]

  @@unique([branch_id, label])
  @@index([branch_id])
  @@map("tables")
}

// A physical screen (queue board, chef board, ...). Authenticates with a
// long-lived opaque credential whose SHA-256 hash is stored here — the raw
// value is shown exactly once at pairing time. Never holds RBAC permissions.
model DisplayDevice {
  id              String              @id @default(uuid()) @db.Uuid
  branch_id       String              @db.Uuid
  name            String
  kind            DisplayDeviceKind
  credential_hash String
  status          DisplayDeviceStatus @default(ACTIVE)
  revoked_at      DateTime?           @db.Timestamptz(3)
  created_at      DateTime            @default(now()) @db.Timestamptz(3)
  updated_at      DateTime            @updatedAt @db.Timestamptz(3)

  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Restrict)

  @@index([branch_id])
  @@index([status])
  @@map("display_devices")
}

// -----------------------------------------------------------------------------
// QUEUE MANAGEMENT (Phase 7)
// -----------------------------------------------------------------------------

// A party waiting for a table. Branch-scoped; company_id is denormalised so a
// token can be scoped in a single WHERE without a join (the same pattern the
// authorization checks use everywhere else).
//
// Status changes only happen through the explicit domain operations in
// QueueTokensService (call / seat / no-show / cancel / assign-table /
// release-table); there is no generic update path.
//
// Table occupancy: a token holds a table while it is SEATED with a non-null
// assigned_table_id. Releasing the table (a manual queue operation until POS
// exists) clears assigned_table_id; the assignment itself is preserved in the
// TABLE_ASSIGNED / TABLE_RELEASED events. Exclusivity is enforced by the
// partial unique index queue_tokens_one_seated_party_per_table (raw SQL in the
// migration — Prisma cannot express partial indexes).
model QueueToken {
  id                String           @id @default(uuid()) @db.Uuid
  company_id        String           @db.Uuid
  branch_id         String           @db.Uuid
  // Optional: anonymous walk-ins have no customer record.
  customer_id       String?          @db.Uuid
  // Calendar date in the BRANCH timezone. Token numbers restart at 1 per
  // branch per service date.
  service_date      DateTime         @db.Date
  token_number      Int
  status            QueueTokenStatus @default(WAITING)
  party_size        Int
  assigned_table_id String?          @db.Uuid
  called_at         DateTime?        @db.Timestamptz(3)
  seated_at         DateTime?        @db.Timestamptz(3)
  cancelled_at      DateTime?        @db.Timestamptz(3)
  no_show_at        DateTime?        @db.Timestamptz(3)
  created_at        DateTime         @default(now()) @db.Timestamptz(3)
  updated_at        DateTime         @updatedAt @db.Timestamptz(3)

  company        Company           @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch         Branch            @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  customer       Customer?         @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  assigned_table Table?            @relation(fields: [assigned_table_id], references: [id], onDelete: Restrict)
  events         QueueTokenEvent[]

  @@unique([branch_id, service_date, token_number])
  @@index([branch_id, service_date, status])
  @@index([company_id])
  @@index([customer_id])
  @@index([assigned_table_id])
  @@map("queue_tokens")
}

// Append-only lifecycle history of a token. UPDATE and DELETE are rejected by
// database triggers (see the migration), mirroring audit_logs.
model QueueTokenEvent {
  id              String              @id @default(uuid()) @db.Uuid
  queue_token_id  String              @db.Uuid
  event_type      QueueTokenEventType
  previous_status QueueTokenStatus?
  new_status      QueueTokenStatus
  // Null when the step is not performed by a staff user (reserved for the
  // scheduler / device paths that later phases add).
  actor_user_id   String?             @db.Uuid
  // Only for table events: { table_id }. Nothing else is stored here.
  metadata        Json?
  created_at      DateTime            @default(now()) @db.Timestamptz(3)

  queue_token QueueToken @relation(fields: [queue_token_id], references: [id], onDelete: Restrict)
  actor       User?      @relation(fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@index([queue_token_id, created_at])
  @@map("queue_token_events")
}

// Per-branch, per-service-date token allocator. Allocation is a single
// INSERT ... ON CONFLICT DO UPDATE ... RETURNING statement inside the
// registration transaction, so PostgreSQL's row lock serialises concurrent
// registrations and no two transactions can observe the same number.
// next_number is the next value to hand out.
model QueueCounter {
  id           String   @id @default(uuid()) @db.Uuid
  branch_id    String   @db.Uuid
  service_date DateTime @db.Date
  next_number  Int      @default(1)
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  updated_at   DateTime @updatedAt @db.Timestamptz(3)

  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Restrict)

  @@unique([branch_id, service_date])
  @@map("queue_counters")
}

// -----------------------------------------------------------------------------
// BANQUET MANAGEMENT (Phase 8)
// -----------------------------------------------------------------------------

// A function room. Branch-scoped, exactly like Table. Deliberately NOT related
// to the deferred Phase 2 Floor model.
model BanquetHall {
  id         String            @id @default(uuid()) @db.Uuid
  branch_id  String            @db.Uuid
  name       String
  capacity   Int
  status     BanquetHallStatus @default(ACTIVE)
  created_at DateTime          @default(now()) @db.Timestamptz(3)
  updated_at DateTime          @updatedAt @db.Timestamptz(3)

  branch   Branch           @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  bookings BanquetBooking[]

  @@unique([branch_id, name])
  @@index([branch_id])
  @@map("banquet_halls")
}

// A commercial offering. COMPANY-scoped like Customer, so one catalogue serves
// every branch. This is not a Product/Menu system: it exists only to price a
// banquet and to hand the kitchen a list of components.
//
// MONEY: price_per_guest_minor is an INTEGER in the minor unit of `currency`
// (e.g. paise for INR, cents for USD). No floating point is used anywhere in
// the money path. The price is PER GUEST — the banquet convention — so a
// booking's total is price × guest_count. That choice is documented in
// banquet-money.ts and snapshotted onto every booking.
model BanquetPackage {
  id                    String               @id @default(uuid()) @db.Uuid
  company_id            String               @db.Uuid
  name                  String
  description           String?
  price_per_guest_minor Int
  currency              String               @db.Char(3)
  status                BanquetPackageStatus @default(ACTIVE)
  created_at            DateTime             @default(now()) @db.Timestamptz(3)
  updated_at            DateTime             @updatedAt @db.Timestamptz(3)

  company  Company              @relation(fields: [company_id], references: [id], onDelete: Restrict)
  items    BanquetPackageItem[]
  bookings BanquetBooking[]

  @@unique([company_id, name])
  @@index([company_id])
  @@map("banquet_packages")
}

// A component of a package (a dish, a service line). Snapshotted onto a booking
// at creation time; editing the package later never rewrites history.
model BanquetPackageItem {
  id         String   @id @default(uuid()) @db.Uuid
  package_id String   @db.Uuid
  name       String
  position   Int
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  package BanquetPackage @relation(fields: [package_id], references: [id], onDelete: Restrict)

  @@index([package_id])
  @@map("banquet_package_items")
}

// A booked event. Branch-scoped; company_id is denormalised for single-query
// scoping, the same pattern QueueToken uses.
//
// TIME: starts_at / ends_at are absolute instants (timestamptz). Overlap is
// therefore evaluated on the real timeline and is DST-proof by construction —
// no wall-clock arithmetic is involved. The branch timezone is used only to
// PRESENT an event and to group the chef display by branch-local day.
//
// SNAPSHOTS: package_name, price_per_guest_minor, currency and
// total_amount_minor are copied at creation. A later edit to the package
// cannot change what a historical booking meant or cost.
//
// The hall is protected by a PostgreSQL exclusion constraint; see the
// migration. `balance` is deliberately NOT a column — it is derived as
// total_amount_minor minus successful payments.
model BanquetBooking {
  id                    String               @id @default(uuid()) @db.Uuid
  company_id            String               @db.Uuid
  branch_id             String               @db.Uuid
  customer_id           String               @db.Uuid
  hall_id               String               @db.Uuid
  package_id            String?              @db.Uuid
  starts_at             DateTime             @db.Timestamptz(3)
  ends_at               DateTime             @db.Timestamptz(3)
  guest_count           Int
  status                BanquetBookingStatus @default(DRAFT)
  // Commercial snapshot, fixed at booking time.
  package_name          String
  price_per_guest_minor Int
  currency              String               @db.Char(3)
  total_amount_minor    Int
  notes                 String?
  confirmed_at          DateTime?            @db.Timestamptz(3)
  completed_at          DateTime?            @db.Timestamptz(3)
  cancelled_at          DateTime?            @db.Timestamptz(3)
  created_at            DateTime             @default(now()) @db.Timestamptz(3)
  updated_at            DateTime             @updatedAt @db.Timestamptz(3)

  company    Company              @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch     Branch               @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  customer   Customer             @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  hall       BanquetHall          @relation(fields: [hall_id], references: [id], onDelete: Restrict)
  package    BanquetPackage?      @relation(fields: [package_id], references: [id], onDelete: Restrict)
  items      BanquetBookingItem[]
  payments   BanquetPayment[]
  event_plan BanquetEventPlan?

  @@index([branch_id, starts_at])
  @@index([branch_id, status])
  @@index([company_id])
  @@index([customer_id])
  @@index([hall_id])
  @@map("banquet_bookings")
}

// The package components as they stood when the booking was made, plus the
// kitchen's preparation state for each. The chef display reads these; staff
// with banquet.kds.manage advance them.
model BanquetBookingItem {
  id          String           @id @default(uuid()) @db.Uuid
  booking_id  String           @db.Uuid
  name        String
  position    Int
  kds_status  BanquetKdsStatus @default(PENDING)
  started_at  DateTime?        @db.Timestamptz(3)
  ready_at    DateTime?        @db.Timestamptz(3)
  created_at  DateTime         @default(now()) @db.Timestamptz(3)
  updated_at  DateTime         @updatedAt @db.Timestamptz(3)

  booking BanquetBooking @relation(fields: [booking_id], references: [id], onDelete: Restrict)

  @@index([booking_id])
  @@map("banquet_booking_items")
}

// The operational plan for one booking: when food is served, how the room is
// set, and what the kitchen needs to know. Deliberately three fields and no
// task list — a task/checklist system is Phase 9 and must not be pre-empted.
model BanquetEventPlan {
  id            String    @id @default(uuid()) @db.Uuid
  booking_id    String    @unique @db.Uuid
  service_at    DateTime? @db.Timestamptz(3)
  setup_notes   String?
  kitchen_notes String?
  created_at    DateTime  @default(now()) @db.Timestamptz(3)
  updated_at    DateTime  @updatedAt @db.Timestamptz(3)

  booking BanquetBooking @relation(fields: [booking_id], references: [id], onDelete: Restrict)

  @@map("banquet_event_plans")
}

// An advance or balance payment against a booking. APPEND-ONLY: UPDATE and
// DELETE are rejected by database triggers, exactly as for audit_logs and
// queue_token_events. There is no refund path — the roadmap does not define
// one, and inventing a negative payment would silently become accounting.
//
// This is NOT Finance: there is no ledger, no journal and no accounting entry.
// It records what a customer paid against one event.
model BanquetPayment {
  id            String   @id @default(uuid()) @db.Uuid
  booking_id    String   @db.Uuid
  company_id    String   @db.Uuid
  branch_id     String   @db.Uuid
  amount_minor  Int
  currency      String   @db.Char(3)
  paid_at       DateTime @db.Timestamptz(3)
  // Free-text snapshot only ("cash", "card ****1234"). PaymentMethod is a
  // deferred Phase 2 entity and is deliberately not referenced.
  method        String?
  reference     String?
  actor_user_id String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(3)

  booking BanquetBooking @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  actor   User?          @relation(fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@index([booking_id, paid_at])
  @@map("banquet_payments")
}

// -----------------------------------------------------------------------------
// TASKS & ROUTINES (Phase 9)
// -----------------------------------------------------------------------------

// A reusable checklist definition. COMPANY-scoped like Customer and
// BanquetPackage, so one definition serves every branch.
//
// Editing a template NEVER rewrites history: a task copies the items it needs
// at creation time (see TaskChecklistItem), so a completed task cannot become
// retroactively incomplete because someone added an item to the template.
model ChecklistTemplate {
  id          String                  @id @default(uuid()) @db.Uuid
  company_id  String                  @db.Uuid
  name        String
  description String?
  status      ChecklistTemplateStatus @default(ACTIVE)
  created_at  DateTime                @default(now()) @db.Timestamptz(3)
  updated_at  DateTime                @updatedAt @db.Timestamptz(3)

  company  Company                 @relation(fields: [company_id], references: [id], onDelete: Restrict)
  items    ChecklistTemplateItem[]
  routines TaskRoutine[]
  tasks    Task[]

  @@unique([company_id, name])
  @@index([company_id])
  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id          String   @id @default(uuid()) @db.Uuid
  template_id String   @db.Uuid
  label       String
  position    Int
  is_required Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  template ChecklistTemplate @relation(fields: [template_id], references: [id], onDelete: Restrict)

  @@index([template_id])
  @@map("checklist_template_items")
}

// A recurring operational definition. BRANCH-scoped, which is what makes the
// timezone unambiguous: a routine's wall-clock time is always read in its
// branch's own timezone (Branch.timezone), never in UTC and never in the
// server's zone. A company-level routine is deliberately not offered — it
// would have no single timezone to be scheduled in.
model TaskRoutine {
  id          String           @id @default(uuid()) @db.Uuid
  company_id  String           @db.Uuid
  branch_id   String           @db.Uuid
  name        String
  description String?
  frequency   RoutineFrequency
  /// Branch-local wall clock, "HH:MM". Interpreted in Branch.timezone.
  time_of_day String
  /// WEEKLY only: 0 = Sunday … 6 = Saturday, in branch-local time.
  weekdays    Int[]
  priority    TaskPriority     @default(NORMAL)
  status      RoutineStatus    @default(ACTIVE)
  /// Copied onto each generated task at materialization time.
  checklist_template_id String? @db.Uuid
  default_assignee_id   String? @db.Uuid
  created_at  DateTime         @default(now()) @db.Timestamptz(3)
  updated_at  DateTime         @updatedAt @db.Timestamptz(3)

  company           Company            @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch            Branch             @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  checklist         ChecklistTemplate? @relation(fields: [checklist_template_id], references: [id], onDelete: Restrict)
  default_assignee  User?              @relation("RoutineDefaultAssignee", fields: [default_assignee_id], references: [id], onDelete: Restrict)
  tasks             Task[]

  @@unique([branch_id, name])
  @@index([branch_id, status])
  @@index([company_id])
  @@map("task_routines")
}

// A concrete operational task. Branch-scoped; company_id is denormalised for
// single-query scoping, the pattern QueueToken and BanquetBooking both use.
//
// IDEMPOTENT ROUTINE MATERIALIZATION: (routine_id, routine_occurrence_date) is
// UNIQUE. PostgreSQL treats NULLs as distinct, so manual tasks — which have
// neither — never collide, while a routine can produce at most one task per
// branch-local occurrence date no matter how many materialization runs race.
// That is the whole idempotency guarantee, enforced by the database rather
// than by an application check that could lose a race.
//
// ASSIGNMENT IS NOT AUTHORIZATION. assignee_id records who is responsible for
// doing the work. It grants nothing: every API operation is still gated by
// RBAC through PermissionGuard.
model Task {
  id                     String       @id @default(uuid()) @db.Uuid
  company_id             String       @db.Uuid
  branch_id              String       @db.Uuid
  title                  String
  description            String?
  status                 TaskStatus   @default(PENDING)
  priority               TaskPriority @default(NORMAL)
  due_at                 DateTime?    @db.Timestamptz(3)
  assignee_id            String?      @db.Uuid
  source                 TaskSource   @default(MANUAL)
  routine_id             String?      @db.Uuid
  /// Branch-local calendar date of the occurrence this task materialises.
  routine_occurrence_date DateTime?   @db.Date
  /// Template the checklist was copied from, for reference only.
  checklist_template_id  String?      @db.Uuid
  started_at             DateTime?    @db.Timestamptz(3)
  completed_at           DateTime?    @db.Timestamptz(3)
  completed_by           String?      @db.Uuid
  cancelled_at           DateTime?    @db.Timestamptz(3)
  created_at             DateTime     @default(now()) @db.Timestamptz(3)
  updated_at             DateTime     @updatedAt @db.Timestamptz(3)

  company        Company            @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch         Branch             @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  assignee       User?              @relation("TaskAssignee", fields: [assignee_id], references: [id], onDelete: Restrict)
  completer      User?              @relation("TaskCompleter", fields: [completed_by], references: [id], onDelete: Restrict)
  routine        TaskRoutine?       @relation(fields: [routine_id], references: [id], onDelete: Restrict)
  checklist_from ChecklistTemplate? @relation(fields: [checklist_template_id], references: [id], onDelete: Restrict)
  checklist      TaskChecklistItem[]

  @@unique([routine_id, routine_occurrence_date])
  @@index([branch_id, status])
  @@index([branch_id, due_at])
  @@index([assignee_id, status])
  @@index([company_id])
  @@map("tasks")
}

// A task's OWN checklist: a snapshot taken when the task was created, never a
// live view of the template. Completion state lives here, so history stays
// truthful however the template changes afterwards.
model TaskChecklistItem {
  id          String    @id @default(uuid()) @db.Uuid
  task_id     String    @db.Uuid
  label       String
  position    Int
  is_required Boolean   @default(true)
  is_done     Boolean   @default(false)
  done_at     DateTime? @db.Timestamptz(3)
  done_by     String?   @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(3)
  updated_at  DateTime  @updatedAt @db.Timestamptz(3)

  task   Task  @relation(fields: [task_id], references: [id], onDelete: Restrict)
  doneBy User? @relation("ChecklistItemDoneBy", fields: [done_by], references: [id], onDelete: Restrict)

  @@index([task_id])
  @@map("task_checklist_items")
}

// -----------------------------------------------------------------------------
// AUTHORIZATION ENTITIES (RBAC)
// -----------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  company_id  String   @db.Uuid
  name        String
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  // Relationships
  company     Company          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  user_roles  UserBranchRole[]

  @@unique([company_id, name])
  @@index([company_id])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique // e.g., 'pos.order.create'
  module      String // e.g., 'pos', 'inventory'
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  // Relationships
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  // Relationships
  role       Role       @relation(fields: [role_id], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Restrict)

  @@id([role_id, permission_id])
  @@index([role_id])
  @@index([permission_id])
  @@map("role_permissions")
}

model UserBranchRole {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  branch_id  String   @db.Uuid
  role_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  // Relationships
  user   User   @relation(fields: [user_id], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [role_id], references: [id], onDelete: Restrict)

  // Constraints
  // A user can only hold a specific role once at a specific branch
  @@unique([user_id, branch_id, role_id])
  @@index([user_id])
  @@index([branch_id])
  @@index([role_id])
  @@map("user_branch_roles")
}

// -----------------------------------------------------------------------------
// AUDIT ENTITIES
// -----------------------------------------------------------------------------

model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  company_id  String?        @db.Uuid
  branch_id   String?        @db.Uuid
  user_id     String?        @db.Uuid
  event_type  AuditEventType
  entity_type String // e.g., 'Order', 'User'
  entity_id   String
  payload     Json // JSONB via PostgreSQL
  created_at  DateTime       @default(now()) @db.Timestamptz(3)

  // Relationships
  company Company? @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch  Branch?  @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  user    User?    @relation(fields: [user_id], references: [id], onDelete: Restrict)

  // Indexes optimized for time-series and scoping queries
  @@index([company_id, created_at])
  @@index([branch_id, created_at])
  @@index([event_type, created_at])
  @@index([entity_type, entity_id])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// AUTHENTICATION & SESSIONS
// -----------------------------------------------------------------------------

model UserSession {
  id                  String    @id @default(uuid()) @db.Uuid
  user_id             String    @db.Uuid
  token_hash          String
  // Sliding window — pushed forward on every successful refresh.
  expires_at          DateTime  @db.Timestamptz(3)
  // Hard ceiling — fixed at login, never extended by refresh.
  absolute_expires_at DateTime  @db.Timestamptz(3)
  revoked_at          DateTime? @db.Timestamptz(3)
  created_at          DateTime  @default(now()) @db.Timestamptz(3)
  updated_at          DateTime  @updatedAt @db.Timestamptz(3)

  // Relationships
  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id])
  @@index([expires_at])
  @@index([revoked_at])
  @@index([absolute_expires_at])
  @@map("user_sessions")
}
