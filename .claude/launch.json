{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev", "--workspace", "api"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "api-attach",
      "url": "http://localhost:3001"
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "web"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "web-attach",
      "url": "http://localhost:3000"
    }
  ]
}
