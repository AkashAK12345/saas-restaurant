# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/samco_db?schema=public"

# Application configurations
NEXT_PUBLIC_API_URL="http://localhost:3001"
PORT=3001

# Authentication
ACCESS_TOKEN_SECRET="generate-a-secure-random-string-for-access-token"
ACCESS_TOKEN_EXPIRES_IN="15m"
# Sliding window: pushed forward on every successful refresh.
REFRESH_TOKEN_EXPIRES_IN_DAYS="7"
# Hard ceiling: fixed at login and never extended, so repeated refreshes cannot
# keep one session alive indefinitely.
REFRESH_TOKEN_ABSOLUTE_DAYS="30"
