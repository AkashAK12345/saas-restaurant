# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/samco_db?schema=public"

# Application configurations
NEXT_PUBLIC_API_URL="http://localhost:3001"
PORT=3001

# Authentication
ACCESS_TOKEN_SECRET="generate-a-secure-random-string-for-access-token"
ACCESS_TOKEN_EXPIRES_IN="15m"
# Sliding window: pushed forward on every successful refresh.
REFRESH_TOKEN_EXPIRES_IN_DAYS="7"
# Hard ceiling: fixed at login and never extended, so repeated refreshes cannot
# keep one session alive indefinitely.
REFRESH_TOKEN_ABSOLUTE_DAYS="30"

# Browser origins allowed to call the API, comma-separated and exact (scheme,
# host and port). The list is an allowlist — the API never reflects an
# arbitrary Origin back. Defaults to the local web app.
CORS_ORIGINS="http://localhost:3000"

# Real-time (SSE)
# Comment-frame keepalive interval. Keep under the ~30s idle timeout common to
# reverse proxies.
SSE_HEARTBEAT_MS="25000"
# Lifetime of a single-use stream ticket — long enough to construct an
# EventSource, short enough that a leaked URL is worthless almost immediately.
STREAM_TICKET_TTL_MS="60000"

# Scheduler (single-instance, in-process). Set to "false" in test/CI processes
# or extra replicas so registered jobs never fire there.
SCHEDULER_ENABLED="true"
